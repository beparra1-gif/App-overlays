DATABASE_URL=postgres://usuario:password@localhost:5432/app_overlays
PORT=3000
JWT_SECRET=cambia-este-secreto
FRONTEND_URL=http://localhost:5183

# Mismo Client ID que VITE_GOOGLE_CLIENT_ID en el frontend (es público, va
# en el HTML) — este lado lo usa para VERIFICAR de verdad cada token contra
# los servidores de Google antes de confiar en él.
GOOGLE_CLIENT_ID=

# Para que "olvidé mi contraseña" mande el email de verdad — cuenta gratis
# en resend.com, API key en el dashboard. Sin esto, el enlace se imprime en
# la consola del servidor en vez de enviarse (sirve para probar en local).
RESEND_API_KEY=
EMAIL_FROM=App-overlays <onboarding@resend.dev>
